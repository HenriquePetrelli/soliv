# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser commitado (está no .gitignore).

# Supabase
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Push notifications (opt-in toggle in Profile > Configurações). Not
# secrets — safe to be public, they only identify the Firebase project.
# Leave empty to keep the feature off; fill in after creating a Firebase
# project with Cloud Messaging enabled (see docs/push-notifications-setup.md).
# The same 6 values also need to be pasted into public/firebase-messaging-sw.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
