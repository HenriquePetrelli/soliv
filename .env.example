# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser commitado (está no .gitignore).

# Supabase
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Push notifications (opt-in toggle in Profile > Configurações). Not
# secrets — safe to be public, they only identify the Firebase project.
# Leave empty to keep the feature off; fill in after creating a Firebase
# project with Cloud Messaging enabled (see docs/push-notifications-setup.md).
# The same 6 values also need to be pasted into public/firebase-messaging-sw.js.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Monitoramento de erros (Grafana Cloud → Frontend Observability). Não é
# segredo: o endereço do coletor fica visível no app, como o do Firebase.
# Vazio = desligado. Passo a passo em docs/monitoramento-grafana.md.
VITE_FARO_URL=
# Parte das sessões enviada (0 a 1). 1 = todas; baixe se chegar perto das
# 50 mil sessões/mês do plano gratuito.
VITE_FARO_SAMPLE_RATE=1
